---
import { site } from '../data/site';
import { getLang, ui } from '../i18n/ui';
import { localizedPath, toCanonicalPath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
const currentPath = toCanonicalPath(Astro.url.pathname);
const nav = [
  { canonical: '/', label: t.nav.inici },
  { canonical: '/sobre-mi', label: t.nav.sobreMi },
  { canonical: '/serveis', label: t.nav.serveis },
  { canonical: '/faqs', label: t.nav.faqs },
];
const mobileNav = [...nav, { canonical: '/contacte', label: t.nav.contacte }];
const legal = [
  { canonical: '/avis-legal', label: t.legalLabels.avisLegal },
  { canonical: '/privacitat', label: t.legalLabels.privacitat },
];
const isActive = (canonical: string) => (canonical === '/serveis' ? currentPath.startsWith('/serveis') : currentPath === canonical);
const href = (canonical: string) => localizedPath(lang, canonical);
const caHref = localizedPath('ca', Astro.url.pathname);
const esHref = localizedPath('es', Astro.url.pathname);
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-brand/10 bg-white/95 backdrop-blur-xl">
  <div class="container-shell flex h-20 items-center justify-between gap-6">
    <a href={href('/')} class="hidden shrink-0 items-center lg:flex" aria-label={`${site.fullName} - ${t.nav.inici}`}>
      <img src="/images/pqimg-640-640/laialogopeda-3.png" alt={site.fullName} class="h-[60px] w-[60px] object-contain" width="640" height="640" loading="eager" />
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-1 lg:flex" aria-label={lang === 'ca' ? 'Navegació principal' : 'Navegación principal'}>
      {nav.map((item) => (
        <a href={href(item.canonical)} class:list={['border-b-2 px-4 py-2 text-sm font-medium uppercase tracking-wide transition', isActive(item.canonical) ? 'border-ink text-ink' : 'border-transparent text-ink/70 hover:border-ink/60 hover:text-ink']} aria-current={isActive(item.canonical) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={href('/contacte')} class="rounded-full bg-brand px-5 py-2.5 text-sm font-medium uppercase tracking-wide text-white outline outline-2 outline-brand transition hover:bg-ink hover:outline-ink">{t.nav.contacte}</a>

      <div class="flex items-center gap-1" aria-label={t.header.social}>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex h-9 w-9 items-center justify-center rounded-full text-brand transition hover:bg-brand-light"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9.5h4v11H3zM9 9.5h3.8v1.5h.05c.53-.9 1.83-1.85 3.77-1.85 4.03 0 4.78 2.65 4.78 6.1v5.25h-4v-4.65c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.73H9z"/></svg></a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full text-brand transition hover:bg-brand-light"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
      </div>

      <details class="group relative">
        <summary class="flex cursor-pointer list-none items-center gap-1 text-sm font-medium uppercase text-brand" aria-label={t.header.selectLanguage}>{lang === 'ca' ? 'CA' : 'ES'}<svg class="transition group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
        <div class="absolute right-0 top-full z-50 mt-3 w-36 overflow-hidden rounded-2xl border border-brand/10 bg-white py-2 shadow-soft">
          <a href={caHref} class:list={['block px-5 py-2.5 text-sm font-medium transition', lang === 'ca' ? 'bg-brand text-white' : 'text-ink hover:bg-brand hover:text-white']} lang="ca" hreflang="ca">Català</a>
          <a href={esHref} class:list={['block px-5 py-2.5 text-sm font-medium transition', lang === 'es' ? 'bg-brand text-white' : 'text-ink hover:bg-brand hover:text-white']} lang="es" hreflang="es">Español</a>
        </div>
      </details>
    </div>

    <div class="flex items-center gap-3 lg:hidden">
      <a href={site.phoneHref} class="flex h-11 w-11 items-center justify-center rounded-xl text-brand transition hover:bg-brand-light" aria-label={t.header.phone}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.69 12.8a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 2.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L6.91 9.91a16 16 0 0 0 6.18 6.18l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 17z"/></svg></a>
      <button id="menu-btn" class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-brand/15 text-brand" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.header.openMenu}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/></svg></button>
    </div>
  </div>
</header>

<div id="mobile-overlay" class="fixed inset-0 z-[60] hidden bg-ink/50 backdrop-blur-sm lg:hidden" aria-hidden="true"></div>
<aside id="mobile-menu" class="pointer-events-none fixed inset-y-0 right-0 z-[70] w-[min(22rem,88vw)] translate-x-full overflow-y-auto bg-white shadow-2xl transition-transform duration-300 lg:hidden" aria-hidden="true" aria-label={t.header.mobileMenu}>
  <div class="flex items-center justify-between border-b border-brand/10 px-6 py-5">
    <img src="/images/pqimg-640-640/laialogopeda-3.png" alt={site.fullName} class="h-11 w-11 object-contain" width="640" height="640" loading="lazy" />
    <button id="menu-close" class="flex h-10 w-10 items-center justify-center rounded-xl text-brand transition hover:bg-brand-light" aria-label={t.header.closeMenu}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  </div>
  <div class="px-6 py-7">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand/70">{t.header.language}</p>
    <div class="mt-3 flex gap-2">
      <a href={caHref} class:list={['rounded-full px-4 py-2 text-sm font-semibold transition', lang === 'ca' ? 'bg-brand text-white' : 'border border-brand/20 text-brand hover:bg-brand-light']} lang="ca" hreflang="ca">Català</a>
      <a href={esHref} class:list={['rounded-full px-4 py-2 text-sm font-semibold transition', lang === 'es' ? 'bg-brand text-white' : 'border border-brand/20 text-brand hover:bg-brand-light']} lang="es" hreflang="es">Español</a>
    </div>

    <nav class="mt-8 flex flex-col gap-1" aria-label={t.header.mobileNav}>
      {mobileNav.map((item) => (
        <a href={href(item.canonical)} class:list={['mobile-link border-b border-brand/10 px-1 py-3 text-sm font-medium uppercase tracking-wide transition', isActive(item.canonical) ? 'text-brand' : 'text-ink/75 hover:text-brand']} aria-current={isActive(item.canonical) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="mt-8">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand/70">{lang === 'ca' ? 'Legal' : 'Legal'}</p>
      <div class="mt-3 flex flex-col gap-1">
        {legal.map((item) => (
          <a href={href(item.canonical)} class="mobile-link py-2 text-sm text-ink/70 transition hover:text-brand">{item.label}</a>
        ))}
      </div>
    </div>

    <div class="mt-8 flex items-center gap-3" aria-label={t.header.social}>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-light text-brand transition hover:bg-brand hover:text-white"><svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5ZM3 9.5h4v11H3zM9 9.5h3.8v1.5h.05c.53-.9 1.83-1.85 3.77-1.85 4.03 0 4.78 2.65 4.78 6.1v5.25h-4v-4.65c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.73H9z"/></svg></a>
      <a href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-light text-brand transition hover:bg-brand hover:text-white"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
    </div>
  </div>
</aside>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const closeBtn = document.getElementById('menu-close');

  const open = () => {
    overlay?.classList.remove('hidden');
    menu?.classList.remove('pointer-events-none', 'translate-x-full');
    menu?.classList.add('translate-x-0', 'pointer-events-auto');
    menu?.setAttribute('aria-hidden', 'false');
    btn?.setAttribute('aria-expanded', 'true');
    document.body.classList.add('overflow-hidden');
  };

  const close = () => {
    overlay?.classList.add('hidden');
    menu?.classList.add('pointer-events-none', 'translate-x-full');
    menu?.classList.remove('translate-x-0', 'pointer-events-auto');
    menu?.setAttribute('aria-hidden', 'true');
    btn?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('overflow-hidden');
  };

  btn?.addEventListener('click', () => {
    if (btn.getAttribute('aria-expanded') === 'true') close();
    else open();
  });
  closeBtn?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });
  document.querySelectorAll('.mobile-link').forEach((link) => link.addEventListener('click', close));
</script>

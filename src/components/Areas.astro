---
const areas = [
  { slug: 'alteracions-en-la-lectura-i-o-escriptura', title: 'Alteracions en la lectura i/o escriptura', image: '/images/img-640-852/img-4174.jpg' },
  { slug: 'alteracions-en-la-parla', title: 'Alteracions en la parla', image: '/images/img-640-852/img-4182.jpg' },
  { slug: 'alteracions-en-la-veu', title: 'Alteracions en la veu', image: '/images/img-640-852/img-0119.jpg' },
  { slug: 'deglucio-atipica', title: 'Alteracions en la deglució', image: '/images/img-640-852/img-9843.jpg' },
  { slug: 'trastorns-del-llenguatge', title: 'Alteracions en el llenguatge', image: '/images/img-640-852/img-9931.jpg' },
];
const slides = [...areas, ...areas.slice(0, 3)];
---
<section class="section-pad relative overflow-hidden bg-white">
  <div class="pointer-events-none absolute inset-0 bg-cover bg-center opacity-[0.08]" aria-hidden="true" style="background-image: url('/images/pwimg-2560/group-1515.png');"></div>
  <div class="container-shell relative">
    <div class="reveal flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <h2 class="section-title !mt-0">Sessions individualitzades i de qualitat</h2>
      <a href="/serveis" class="inline-flex shrink-0 items-center justify-center rounded-full border border-brand/25 bg-white px-6 py-3 text-sm font-semibold text-brand transition hover:bg-brand-light">Veure serveis</a>
    </div>
    <div data-areas-carousel class="mt-12" role="group" aria-roledescription="carrusel" aria-label="Serveis de logopèdia">
      <div data-carousel-track class="flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {slides.map((area, i) => (
          <a data-carousel-card href={`/serveis/${area.slug}`} class="reveal group relative block w-[85%] shrink-0 snap-start overflow-hidden rounded-[1.75rem] bg-ink shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-soft sm:w-[calc((100%-1.25rem)/2)] lg:w-[calc((100%-2.5rem)/3)]" style={`transition-delay:${i * 60}ms`}>
            <img src={area.image} alt={area.title} class="h-80 w-full object-cover transition duration-500 group-hover:scale-[1.04]" width="640" height="852" loading="lazy" decoding="async" />
            <span class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/10 to-transparent" aria-hidden="true"></span>
            <span class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 p-6">
              <span class="font-display text-xl font-bold text-white">{area.title}</span>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/95 text-brand transition group-hover:bg-brand group-hover:text-white">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
              </span>
            </span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex justify-center gap-2" role="group" aria-label="Navegació del carrusel">
        {areas.map((area, i) => (
          <button type="button" data-carousel-dot aria-label={`Mostrar ${area.title}`} aria-current={i === 0 ? 'true' : 'false'} class:list={['h-2 rounded-full transition-all duration-300', i === 0 ? 'w-6 bg-brand' : 'w-2 bg-brand/25 hover:bg-brand/50']}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-areas-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('[data-carousel-card]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    if (!track || cards.length < 2 || dots.length === 0) return;

    const count = dots.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;
    let resetTimer: number | undefined;
    let resetting = false;

    const step = () => {
      const width = cards[0].getBoundingClientRect().width;
      const gap = parseFloat(window.getComputedStyle(track).columnGap || '0') || 0;
      return width + gap;
    };

    const clearReset = () => {
      if (resetTimer !== undefined) {
        window.clearTimeout(resetTimer);
        resetTimer = undefined;
      }
      resetting = false;
    };

    const updateDots = () => {
      const active = index % count;
      dots.forEach((dot, i) => {
        const isActive = i === active;
        dot.classList.toggle('w-6', isActive);
        dot.classList.toggle('bg-brand', isActive);
        dot.classList.toggle('w-2', !isActive);
        dot.classList.toggle('bg-brand/25', !isActive);
        dot.classList.toggle('hover:bg-brand/50', !isActive);
        dot.setAttribute('aria-current', isActive ? 'true' : 'false');
      });
    };

    const scheduleReset = () => {
      if (index < count || resetting) return;
      resetting = true;
      resetTimer = window.setTimeout(() => {
        track.scrollTo({ left: 0, behavior: 'auto' });
        clearReset();
        index = 0;
        updateDots();
      }, reduced ? 0 : 650);
    };

    const goTo = (next: number) => {
      clearReset();
      index = next;
      track.scrollTo({ left: index * step(), behavior: reduced ? 'auto' : 'smooth' });
      updateDots();
      scheduleReset();
    };

    const start = () => {
      if (reduced || timer !== undefined) return;
      timer = window.setInterval(() => goTo(index + 1), 4000);
    };

    const stop = () => {
      if (timer === undefined) return;
      window.clearInterval(timer);
      timer = undefined;
    };

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stop();
        goTo(i);
      });
    });

    track.addEventListener('scroll', () => {
      if (resetting) return;
      const current = Math.round(track.scrollLeft / step());
      if (current !== index) {
        index = current;
        updateDots();
        scheduleReset();
      }
    });

    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    start();
  });
</script>

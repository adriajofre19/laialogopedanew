---
import { getLang, ui } from '../i18n/ui';
import { localizedPath } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = ui[lang];
---
<section class="relative overflow-hidden bg-hero-glow pt-28 md:pt-32">
  <div class="absolute inset-0 soft-grid opacity-40" aria-hidden="true"></div>
  <div class="absolute -right-24 top-24 h-72 w-72 rounded-full bg-brand/10 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-brand-light blur-3xl" aria-hidden="true"></div>

  <div class="container-shell relative grid items-center gap-12 pb-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:pb-24">
    <div class="reveal">
      <h1 class="font-display text-4xl font-extrabold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        {t.hero.titleStart} <span class="text-brand">{t.hero.titleAccent}</span> {t.hero.titleEnd}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink/75">
        {t.hero.lead}
      </p>
      <a href={localizedPath(lang, '/serveis')} class="mt-8 inline-flex items-center justify-center rounded-full bg-brand px-7 py-3.5 text-base font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-brand-dark">{t.common.veureServeis}</a>
    </div>

    <div class="reveal relative">
      <div class="relative overflow-hidden rounded-[2rem] border border-white/80 bg-white p-3 shadow-card">
        <img src="/images/img-1024-768/img-4122-stjulia-1-2.jpg" alt={t.hero.alt} class="h-[380px] w-full rounded-[1.5rem] object-cover object-center sm:h-[480px]" width="1024" height="768" loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </div>
</section>

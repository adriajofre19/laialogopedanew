---
interface Props {
  images: string[];
  alt: string;
  label: string;
}

const { images, alt, label } = Astro.props;
---
<div data-service-slider class="card relative aspect-video max-h-[560px] w-full overflow-hidden bg-brand-light shadow-soft" role="group" aria-roledescription="carrusel" aria-label={label}>
  {images.map((file, i) => (
    <div data-slide class:list={['absolute inset-0 transition-opacity duration-700 ease-in-out', i === 0 ? 'opacity-100' : 'opacity-0']} aria-hidden={i === 0 ? 'false' : 'true'}>
      <img src={`/images/img-1024-576/${file}`} alt={alt} class="h-full w-full object-cover" width="1024" height="576" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-service-slider]').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
    if (slides.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let current = 0;
    let timer: number | undefined;

    const goTo = (index: number) => {
      current = index;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('opacity-100', active);
        slide.classList.toggle('opacity-0', !active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
    };

    const start = () => {
      if (timer !== undefined) return;
      timer = window.setInterval(() => goTo((current + 1) % slides.length), 5000);
    };

    const stop = () => {
      if (timer === undefined) return;
      window.clearInterval(timer);
      timer = undefined;
    };

    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);
    start();
  });
</script>

---
import { site } from '../data/site';
const year = new Date().getFullYear();
const nav = [
  { href: '/', label: 'Inici' },
  { href: '/sobre-mi', label: 'Sobre mi' },
  { href: '/serveis', label: 'Serveis' },
  { href: '/faqs', label: 'FAQS' },
  { href: '/contacte', label: 'Contacte' },
];
const legal = [
  { href: '/avis-legal', label: 'Avís legal' },
  { href: '/privacitat', label: 'Política de privacitat' },
  { href: '/politica-de-cookies', label: 'Política de cookies' },
  { href: '/preferencies-de-cookies', label: 'Preferències de cookies' },
  { href: '/mapa-web', label: 'Mapa web' },
  { href: '/accessibilitat', label: 'Accessibilitat' },
];
---
<footer class="border-t border-brand/10 bg-mist/40 pt-14 pb-8">
  <div class="container-shell">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.2fr_0.8fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <img src="/images/pqimg-640-640/laialogopeda.png" alt="Laia Carbonell Renart" class="h-11 w-11 rounded-2xl object-contain bg-brand-light p-1.5" width="416" height="640" loading="lazy" />
          <span class="font-display text-2xl font-extrabold text-ink">Laia Carbonell</span>
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink/70">Logopèdia personalitzada i humanitzada de proximitat. Compromís, experiència i benestar personal.</p>
        <div class="mt-5 flex gap-4">
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-sm font-semibold text-brand hover:underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17" cy="7" r="1"/></svg>
            Instagram
          </a>
        </div>
      </div>
      <div>
        <p class="font-display text-lg font-bold text-ink">Navegació</p>
        <ul class="mt-4 space-y-2">
          {nav.map((item) => <li><a href={item.href} class="text-sm text-ink/70 transition hover:text-brand">{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="font-display text-lg font-bold text-ink">Contacte</p>
        <ul class="mt-4 space-y-3 text-sm text-ink/70">
          <li><a href={site.phoneHref} class="hover:text-brand">{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`} class="break-all hover:text-brand">{site.email}</a></li>
          <li>{site.hours}</li>
          {site.locations.map((loc) => <li>{loc.address}</li>)}
        </ul>
      </div>
    </div>
    <div class="mt-10 border-t border-brand/10 pt-6 text-sm text-ink/55">
      <p>© {year} Laia Carbonell. Tots els drets reservats.</p>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {legal.map((item) => <li><a href={item.href} class="transition hover:text-brand">{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

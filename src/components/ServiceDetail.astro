---
import { services, type Service } from '../data/services';
import ServiceSlider from './ServiceSlider.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const related = services.filter((item) => item.slug !== service.slug);
---
<section class="section-pad bg-white pt-32 md:pt-36">
  <div class="container-shell">
    <nav class="mb-8 flex flex-wrap items-center gap-2 text-sm text-ink/60" aria-label="Fil d'Ariadna">
      <a href="/serveis" class="font-semibold text-brand transition hover:text-brand-dark">Serveis</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink/80">{service.title}</span>
    </nav>

    <div class="reveal max-w-3xl">
      <span class="eyebrow">Laia Logopeda</span>
      <h1 class="section-title mt-3">{service.title}</h1>
    </div>

    <div class="reveal mt-8">
      <ServiceSlider images={service.gallery} alt={`Activitat de logopèdia: ${service.title}`} />
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.2fr_.8fr] lg:items-start">
      <div class="reveal max-w-2xl">
        <p class="text-base leading-relaxed text-ink/75 sm:text-lg">{service.intro}</p>

        <div class="mt-8 space-y-5 text-base leading-relaxed text-ink/80">
          {service.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {service.topics?.map((topic) => (
            <div>
              <h2 class="font-display text-xl font-bold text-ink">{topic.title}</h2>
              <p class="mt-2">{topic.description}</p>
            </div>
          ))}
          {service.closing && <p>{service.closing}</p>}
        </div>
      </div>

      <aside class="reveal card p-6 lg:sticky lg:top-28">
        <p class="font-display text-xl font-bold text-ink">Contacta per a reservar la teva sessió</p>
        <p class="mt-2 text-sm leading-relaxed text-ink/70">Parlem de què necessites i trobem el millor acompanyament per a tu.</p>
        <a href="/contacte" class="mt-5 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white shadow-soft transition hover:-translate-y-0.5 hover:bg-brand-dark">Contacta <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
      </aside>
    </div>

    <div class="mt-16 border-t border-brand/10 pt-12">
      <h2 class="font-display text-2xl font-bold text-ink">També et pot interessar</h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map((item) => (
          <a href={`/serveis/${item.slug}`} class="group card overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-soft">
            <div class="relative overflow-hidden">
              <img src={item.image} alt={item.alt} class="h-40 w-full object-cover transition duration-500 group-hover:scale-[1.03]" width="1024" height="768" loading="lazy" decoding="async" />
            </div>
            <div class="p-4">
              <h3 class="font-display text-base font-bold leading-tight text-ink">{item.title}</h3>
              <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand">Veure servei <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { faqs } from '../data/faqs';
---
<section class="section-pad bg-mist/60 pt-32 md:pt-36">
  <div class="container-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div class="reveal">
      <span class="eyebrow">Laia Logopeda</span>
      <h1 class="section-title">FAQS</h1>
      <p class="section-lead">Resol els teus dubtes. A continuació trobaràs les respostes a les preguntes més freqüents sobre els serveis de logopèdia, el funcionament de les sessions i altres dubtes comuns.</p>
      <div class="mt-8 rounded-[1.75rem] bg-brand p-6 text-white shadow-soft sm:p-8">
        <p class="font-display text-2xl font-bold">Contacta sense compromís</p>
        <p class="mt-3 text-white/85 leading-relaxed">Si no trobes la resposta que busques, no dubtis a contactar-nos!</p>
        <a href="/contacte" class="mt-5 inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand-light">Contacta</a>
      </div>
    </div>
    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="reveal group card overflow-hidden" style={`transition-delay:${i * 40}ms`}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 sm:p-6">
            <span class="font-display text-lg font-bold text-ink sm:text-xl">{faq.question}</span>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-light text-brand transition group-open:rotate-45">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <div class="px-5 pb-5 sm:px-6 sm:pb-6">
            <div class="space-y-3 border-t border-brand/10 pt-4 text-[15px] leading-relaxed text-ink/75">{faq.answer.map((p) => <p>{p}</p>)}</div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

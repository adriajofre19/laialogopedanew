---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { services } from '../data/services';

const mainPages = [
  { href: '/', label: 'Inici', action: false },
  { href: '/sobre-mi', label: 'Sobre mi', action: false },
  { href: '/serveis', label: 'Serveis', action: false },
  { href: '/faqs', label: 'FAQS', action: false },
  { href: '/contacte', label: 'Contacte', action: false },
];
const servicePages = services.map((service) => ({ href: `/serveis/${service.slug}`, label: service.title, action: false }));
const legalPages = [
  { href: '/avis-legal', label: 'Avís legal', action: false },
  { href: '/privacitat', label: 'Política de privacitat', action: false },
  { href: '/politica-de-cookies', label: 'Política de cookies', action: false },
  { href: '#', label: 'Preferències de cookies', action: true },
  { href: '/mapa-web', label: 'Mapa web', action: false },
  { href: '/accessibilitat', label: 'Accessibilitat', action: false },
];
const groups = [
  { title: 'Navegació principal', pages: mainPages },
  { title: 'Serveis', pages: servicePages },
  { title: 'Informació legal', pages: legalPages },
];
---
<Layout title="Mapa web | Laia Carbonell Renart" description="Mapa web de laialogopeda.com amb tots els enllaços del lloc web.">
  <Header />
  <main id="main" class="container-shell py-32 md:py-36">
    <span class="eyebrow">Informació</span>
    <h1 class="mt-6 font-display text-4xl font-extrabold text-ink">Mapa web</h1>
    <p class="mt-5 max-w-3xl leading-relaxed text-ink/75">Aquí trobaràs tots els enllaços del lloc web de Laia Carbonell Renart.</p>
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {groups.map((group) => (
        <article class="card p-6 sm:p-7">
          <h2 class="font-display text-xl font-bold text-ink">{group.title}</h2>
          <ul class="mt-4 space-y-3">
            {group.pages.map((page) => (
              <li>{page.action ? <button type="button" data-cookie-preferences class="text-left text-[15px] text-ink/75 transition hover:text-brand">{page.label}</button> : <a href={page.href} class="text-[15px] text-ink/75 transition hover:text-brand">{page.label}</a>}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

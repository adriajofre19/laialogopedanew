---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { site } from '../../data/site';

const sections = [
  {
    title: 'Declaración de accesibilidad',
    paragraphs: [
      `${site.fullName} se compromete a facilitar la accesibilidad del sitio web laialogopeda.com, tomando como referencia la norma UNE-EN 301549:2022 y las Pautas de Accesibilidad para el Contenido Web (WCAG) 2.1, nivel AA.`,
    ],
  },
  {
    title: 'Situación de cumplimiento',
    paragraphs: [
      'El sitio web laialogopeda.com ha sido revisado y cumple los requisitos de accesibilidad del nivel AA de las WCAG 2.1 y los requisitos aplicables de la norma UNE-EN 301549:2022.',
      'Nivel de accesibilidad: AA (WCAG 2.1).',
      'Fecha de la última revisión: 19/12/2025.',
    ],
  },
  {
    title: 'Comunicación de incidencias y sugerencias',
    paragraphs: [
      'Cualquier persona que encuentre dificultades para acceder a los contenidos o funcionalidades de este sitio web puede comunicar las incidencias detectadas, presentar sugerencias de mejora o solicitar información sobre su accesibilidad.',
      `Para hacerlo, puedes ponerte en contacto mediante el correo electrónico ${site.email} o el teléfono ${site.phone}.`,
    ],
  },
  {
    title: 'Medidas de accesibilidad',
    paragraphs: [
      'El sitio web dispone de una estructura clara de navegación, textos alternativos en las imágenes informativas, contrastes suficientes, navegación por teclado y adaptación a diferentes tamaños de pantalla.',
      'Se revisan periódicamente los contenidos y las funcionalidades para mantener el nivel de accesibilidad y corregir las incidencias que se detecten.',
    ],
  },
];
---
<Layout title="Accesibilidad | Laia Carbonell Renart" description="Declaración de accesibilidad del sitio web de Laia Carbonell Renart, logopeda.">
  <Header />
  <main id="main" class="container-shell py-32 md:py-36">
    <span class="eyebrow">Información</span>
    <h1 class="mt-6 font-display text-4xl font-extrabold text-ink">Accesibilidad</h1>
    <p class="mt-5 max-w-3xl leading-relaxed text-ink/75">Laia Carbonell Renart quiere que todas las personas puedan acceder a la información y a los servicios de este sitio web.</p>
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {sections.map((section) => (
        <article class="card p-6 sm:p-7">
          <h2 class="font-display text-xl font-bold text-ink">{section.title}</h2>
          <div class="mt-3 space-y-3 text-[15px] leading-relaxed text-ink/75">{section.paragraphs.map((p) => <p>{p}</p>)}</div>
        </article>
      ))}
    </div>
    <div class="mt-8 card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">¿Has encontrado alguna incidencia?</h2>
        <p class="mt-1 text-sm text-ink/70">Escríbenos y la revisaremos.</p>
      </div>
      <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">Contactar</a>
    </div>
  </main>
  <Footer />
</Layout>

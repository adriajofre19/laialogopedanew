---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const sections = [
  {
    title: 'Declaració d’accessibilitat',
    paragraphs: [
      `${site.fullName} es compromet a facilitar l’accessibilitat del lloc web laialogopeda.com, prenent com a referència la norma UNE-EN 301549:2022 i les Pautes d’accessibilitat per al contingut web (WCAG) 2.1, nivell AA.`,
    ],
  },
  {
    title: 'Situació de compliment',
    paragraphs: [
      'El lloc web laialogopeda.com ha estat revisat i compleix els requisits d’accessibilitat del nivell AA de les WCAG 2.1 i els requisits aplicables de la norma UNE-EN 301549:2022.',
      'Nivell d’accessibilitat: AA (WCAG 2.1).',
      'Data de l’última revisió: 19/12/2025.',
    ],
  },
  {
    title: 'Comunicació d’incidències i suggeriments',
    paragraphs: [
      'Qualsevol persona que trobi dificultats per accedir als continguts o funcionalitats d’aquest lloc web pot comunicar les incidències detectades, presentar suggeriments de millora o sol·licitar informació sobre la seva accessibilitat.',
      `Per fer-ho, pots posar-te en contacte mitjançant el correu electrònic ${site.email} o el telèfon ${site.phone}.`,
    ],
  },
  {
    title: 'Mesures d’accessibilitat',
    paragraphs: [
      'El lloc web disposa d’una estructura clara de navegació, textos alternatius a les imatges informatives, contrastos suficients, navegació per teclat i adaptació a diferents mides de pantalla.',
      'Es revisen periòdicament els continguts i les funcionalitats per mantenir el nivell d’accessibilitat i corregir les incidències que es detectin.',
    ],
  },
];
---
<Layout title="Accessibilitat | Laia Carbonell Renart" description="Declaració d’accessibilitat del lloc web de Laia Carbonell Renart, logopeda.">
  <Header />
  <main id="main" class="container-shell py-32 md:py-36">
    <span class="eyebrow">Informació</span>
    <h1 class="mt-6 font-display text-4xl font-extrabold text-ink">Accessibilitat</h1>
    <p class="mt-5 max-w-3xl leading-relaxed text-ink/75">Laia Carbonell Renart vol que totes les persones puguin accedir a la informació i als serveis d’aquest lloc web.</p>
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {sections.map((section) => (
        <article class="card p-6 sm:p-7">
          <h2 class="font-display text-xl font-bold text-ink">{section.title}</h2>
          <div class="mt-3 space-y-3 text-[15px] leading-relaxed text-ink/75">{section.paragraphs.map((p) => <p>{p}</p>)}</div>
        </article>
      ))}
    </div>
    <div class="mt-8 card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="font-display text-xl font-bold text-ink">Has trobat alguna incidència?</h2>
        <p class="mt-1 text-sm text-ink/70">Escriu-nos i la revisarem.</p>
      </div>
      <a href={`mailto:${site.email}`} class="inline-flex items-center justify-center rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark">Contactar</a>
    </div>
  </main>
  <Footer />
</Layout>
